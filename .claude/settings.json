{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.js\"",
            "timeout": 15,
            "statusMessage": "Cargando task.md y memory.md de la spec activa"
          }
        ]
      }
    ]
  }
}

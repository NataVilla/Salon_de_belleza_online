# Plantilla de variables de entorno. Copiar a .env.development, .env.qa o .env.production
# y completar los valores. Los archivos reales NO se suben a git.
# La app carga .env.<NODE_ENV> (development por defecto). Las variables definidas en el
# sistema (por ejemplo, en Railway) tienen prioridad sobre las del archivo.

PORT=3000

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
